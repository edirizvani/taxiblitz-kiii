# Copy to .env and set strong values. Never commit the real .env file.
# If a value contains a "$", wrap it in single quotes.

# ── Image ───────────────────────────────────────────────
DOCKERHUB_USER=your-dockerhub-user
TAG=latest

# ── Host ports ──────────────────────────────────────────
WEB_PORT=8080
MAILPIT_UI_PORT=8025
SQL_HOST_PORT=14333

# ── SQL Server (min 8 chars, upper + lower + digit + symbol) ─
SA_PASSWORD=ChangeMe_Strong!Passw0rd

# ── Application admin account (seeded on first start) ───
ADMIN_EMAIL=admin@taxiblitz.local
ADMIN_SEED_PASSWORD=Admin_ChangeMe1!

# ── Optional integrations ───────────────────────────────
OPENWEATHER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
