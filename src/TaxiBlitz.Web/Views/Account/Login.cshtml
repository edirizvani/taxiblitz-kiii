
@model LoginViewModel
@{
    ViewBag.Title = "Log in";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <meta name="robots" content="noindex, nofollow" />
}
@{
}

<style>
    .tb-body { padding-top: 0 !important; }
</style>

<div class="dt-auth">
    <!-- Left: form -->
    <div class="dt-auth-left">
        <div class="dt-auth-content">
            <div class="dt-auth-brand">
                <a class="dt-brand" href="@Url.Action("Index","Home")">
                    <span class="dt-brand-mark"><span class="dt-brand-mark-dot"></span></span>
                    <span class="dt-brand-text">TaxiBlitz <em class="serif-it">Ohrid</em></span>
                </a>
            </div>

            <div class="dt-auth-card">
                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, null, new { role = "form", autocomplete = "on" })) {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ReturnUrl)

                    <h2 class="dt-auth-h">Welcome<br><em class="serif-it">back.</em></h2>
                    <p class="dt-auth-sub">Sign in to manage your bookings and profile.</p>

                    @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })
                    @if (TempData["Info"] != null)
                    {
                        <div class="auth-info-message">@TempData["Info"]</div>
                    }

                    <div class="dt-field">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { @class = "", placeholder = "your@email.com", autocomplete = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="dt-field">
                        @Html.LabelFor(m => m.Password)
                        <div class="dt-pw-wrap">
                            @Html.PasswordFor(m => m.Password, new { @class = "", placeholder = "••••••••", autocomplete = "current-password" })
                            <button type="button" class="dt-pw-toggle" tabindex="-1" aria-label="Show password" onclick="tbTogglePassword(this)">
                                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="dt-auth-row">
                        <label class="dt-checkbox">
                            @Html.CheckBoxFor(m => m.RememberMe)
                            <span class="dt-checkbox-mark">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
                            </span>
                            Remember me
                        </label>
                        @Html.ActionLink("Forgot password?", "ForgotPassword", null, new { @class = "dt-auth-link" })
                    </div>

                    <button type="submit" class="dt-auth-submit">
                        Sign in
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>

                    <div class="dt-auth-foot">
                        <span>Don't have an account? <strong>@Html.ActionLink("Register", "Register", null, new { @class = "dt-auth-link" })</strong></span>
                    </div>
                }

                @if (TempData["GoogleError"] != null) {
                    <div class="validation-summary-errors" style="margin-top:16px;">@TempData["GoogleError"]</div>
                }
                @if (TempData["Error"] != null) {
                    <div class="validation-summary-errors" style="margin-top:16px;">@TempData["Error"]</div>
                }
                <div class="dt-auth-divider"><span>or continue with</span></div>
                @using (Html.BeginForm("ExternalLogin", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, null, new { id = "external-login-form" })) {
                    @Html.AntiForgeryToken()
                    <button type="submit" name="provider" value="Google" class="dt-social-btn dt-social-google">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                        </svg>
                        <span>Continue with Google</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Right: photo -->
    <div class="dt-auth-right">
        <div class="dt-auth-photo"></div>
        <div class="dt-auth-photo-overlay"></div>
        <div class="dt-auth-photo-quote">
            "Every road around Ohrid tells a story — let us show you <em>all of them.</em>"
            <div class="dt-auth-photo-author">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/></svg>
                Zuli Rizvani
                <span>© TaxiBlitz Ohrid</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/js/auth-utils.js")"></script>
}
