@model RegisterViewModel
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <meta name="robots" content="noindex, nofollow" />
}

<style>
    .tb-body { padding-top: 0 !important; }
</style>

<div class="dt-auth">
    <div class="dt-auth-left">
        <div class="dt-auth-content">
            <div class="dt-auth-brand">
                <a class="dt-brand" href="@Url.Action("Index","Home")">
                    <span class="dt-brand-mark"><span class="dt-brand-mark-dot"></span></span>
                    <span class="dt-brand-text">TaxiBlitz <em class="serif-it">Ohrid</em></span>
                </a>
            </div>
            <div class="dt-auth-card">
                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" })) {
                    @Html.AntiForgeryToken()
                    <h2 class="dt-auth-h">Create an<br><em class="serif-it">account.</em></h2>
                    <p class="dt-auth-sub">Join to manage bookings and get personalised tour recommendations.</p>
                    @Html.ValidationSummary("", new { @class = "validation-summary-errors" })
                    <div style="display:flex;gap:12px;">
                        <div class="dt-field" style="flex:1;">
                            @Html.LabelFor(m => m.FirstName)
                            @Html.TextBoxFor(m => m.FirstName, new { placeholder = "Jane", autocomplete = "given-name" })
                            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "field-validation-error" })
                        </div>
                        <div class="dt-field" style="flex:1;">
                            @Html.LabelFor(m => m.LastName)
                            @Html.TextBoxFor(m => m.LastName, new { placeholder = "Smith", autocomplete = "family-name" })
                            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "field-validation-error" })
                        </div>
                    </div>
                    <div class="dt-field">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new { placeholder = "your@email.com", autocomplete = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field">
                        @Html.LabelFor(m => m.Password)
                        <div class="dt-pw-wrap">
                            @Html.PasswordFor(m => m.Password, new { placeholder = "••••••••", autocomplete = "new-password", id = "regPassword", oninput = "tbPasswordStrength(this,'regStrength')" })
                            <button type="button" class="dt-pw-toggle" tabindex="-1" aria-label="Show password" onclick="tbTogglePassword(this)">
                                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                        <div class="dt-pw-strength" id="regStrength" style="display:none;">
                            <div class="dt-pw-strength-bar" data-seg="1"></div>
                            <div class="dt-pw-strength-bar" data-seg="2"></div>
                            <div class="dt-pw-strength-bar" data-seg="3"></div>
                            <div class="dt-pw-strength-bar" data-seg="4"></div>
                            <span class="dt-pw-strength-label"></span>
                        </div>
                    </div>
                    <div class="dt-field">
                        @Html.LabelFor(m => m.ConfirmPassword)
                        <div class="dt-pw-wrap">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "••••••••", autocomplete = "new-password", oninput = "tbConfirmMatch(this,'regPassword','regMatchOk','regMatchErr')" })
                            <button type="button" class="dt-pw-toggle" tabindex="-1" aria-label="Show password" onclick="tbTogglePassword(this)">
                                <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
                        <div class="dt-match-ok" id="regMatchOk">✓ Passwords match</div>
                        <div class="dt-match-err" id="regMatchErr">✗ Passwords don't match</div>
                    </div>
                    <div class="dt-field">
                        <label>Phone number</label>
                        <div class="dt-phone-row">
                            <select id="regPhonePrefix" class="dt-phone-prefix"></select>
                            <input id="regPhoneCustom" type="text" placeholder="+XX" class="dt-phone-custom" style="display:none;">
                            <input id="regPhoneLocal" type="tel" placeholder="70 000 000" class="dt-phone-local">
                        </div>
                        <input type="hidden" id="PhoneNumber" name="PhoneNumber" />
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "field-validation-error" })
                    </div>
                    <button type="submit" class="dt-auth-submit">
                        Create account
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                    <div class="dt-auth-foot">
                        <span>Already have an account? <strong>@Html.ActionLink("Sign in", "Login", null, new { @class = "dt-auth-link" })</strong></span>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="dt-auth-right">
        <div class="dt-auth-photo"></div>
        <div class="dt-auth-photo-overlay"></div>
        <div class="dt-auth-photo-quote">
            "The lake remembers every journey — <em>yours will be unforgettable.</em>"
            <div class="dt-auth-photo-author">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/></svg>
                Rexhep Rizvani <span>· TaxiBlitz Ohrid</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validate/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validate-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="@Url.Content("~/js/phone-prefix.js")"></script>
    <script src="@Url.Content("~/js/auth-utils.js")"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            initPhonePrefix({
                formSel:   'form',
                selectSel: '#regPhonePrefix',
                customSel: '#regPhoneCustom',
                localSel:  '#regPhoneLocal',
                hiddenSel: '#PhoneNumber'
            });
        });
    </script>
}

