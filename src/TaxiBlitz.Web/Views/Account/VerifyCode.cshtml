@model VerifyCodeViewModel
@{
    ViewBag.Title = "Verify code";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .tb-body { padding-top: 0 !important; }
</style>

<div class="dt-auth">
    <div class="dt-auth-left">
        <div class="dt-auth-content">
            <div class="dt-auth-brand">
                <a class="dt-brand" href="@Url.Action("Index","Home")">
                    <span class="dt-brand-mark"><span class="dt-brand-mark-dot"></span></span>
                    <span class="dt-brand-text">TaxiBlitz <em class="serif-it">Ohrid</em></span>
                </a>
            </div>

            <div class="dt-auth-card">
                @using (Html.BeginForm("VerifyCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, null, new { role = "form", autocomplete = "off" })) {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("provider", @Model.Provider)
                    @Html.Hidden("rememberMe", @Model.RememberMe)

                    <h2 class="dt-auth-h">Enter<br><em class="serif-it">your code.</em></h2>
                    <p class="dt-auth-sub">We sent a security code to your email. Enter it below to continue.</p>

                    @Html.ValidationSummary("", new { @class = "validation-summary-errors" })

                    <div class="dt-field">
                        <label for="Code">Security code</label>
                        @Html.TextBoxFor(m => m.Code, new { placeholder = "000000", autocomplete = "one-time-code", inputmode = "numeric", id = "Code", maxlength = "6" })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="dt-auth-row" style="margin-top:8px;">
                        <label class="dt-checkbox">
                            @Html.CheckBoxFor(m => m.RememberBrowser)
                            <span class="dt-checkbox-mark">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
                            </span>
                            @Html.LabelFor(m => m.RememberBrowser)
                        </label>
                    </div>

                    <button type="submit" class="dt-auth-submit">
                        Verify
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="dt-auth-right">
        <div class="dt-auth-photo"></div>
        <div class="dt-auth-photo-overlay"></div>
        <div class="dt-auth-photo-quote">
            "Security is the road that gets you <em>everywhere safely.</em>"
            <div class="dt-auth-photo-author">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/></svg>
                TaxiBlitz Ohrid
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validate/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validate-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="@Url.Content("~/js/auth-utils.js")"></script>
}

