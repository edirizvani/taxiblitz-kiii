@model ExternalLoginListViewModel
@inject SignInManager<ApplicationUser> ExtSignInManager
<h4>Use another service to log in.</h4>
<hr />
@{
    var loginProviders = (await ExtSignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
    if (loginProviders.Count == 0) {
        <div>
            <p>
                There are no external authentication services configured.
            </p>
        </div>
    }
    else {
        using (Html.BeginForm("ExternalLogin", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, null, new { role = "form" })) {
            @Html.AntiForgeryToken()
            <div id="socialLoginList">
                <p>
                    @foreach (var p in loginProviders) {
                        <button type="submit" class="btn btn-outline-dark" id="@p.Name" name="provider" value="@p.Name" title="Log in using your @p.DisplayName account">@p.Name</button>
                    }
                </p>
            </div>
        }
    }
}

