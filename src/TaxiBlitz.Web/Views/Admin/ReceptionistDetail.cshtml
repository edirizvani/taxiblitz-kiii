@model TaxiBlitz.Application.ViewModels.AdminReceptionistDetailViewModel
@using System.Globalization

<style>
    @@media (max-width: 640px) {
        .dt-page-head h1 { font-size: 28px !important; }
        .dt-admin-table-section { margin: 0 16px 40px !important; padding: 0 !important; }

        .dt-admin-table thead { display: none; }
        .dt-admin-table,
        .dt-admin-table tbody,
        .dt-admin-table tr,
        .dt-admin-table td { display: block; width: 100%; box-sizing: border-box; }
        .dt-admin-table { border-radius: 0; border: none; background: transparent; }
        .dt-admin-table tr {
            border: 1px solid var(--line);
            border-radius: 16px;
            margin-bottom: 10px;
            overflow: hidden;
            background: var(--ink-2);
        }
        .dt-admin-table td {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            padding: 10px 14px;
            font-size: 13px;
            border-top: 1px solid var(--line);
        }
        .dt-admin-table td:first-child { border-top: none; }
        .dt-admin-table td::before {
            content: attr(data-label);
            font-family: var(--mono);
            font-size: 10px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--fg-3);
            flex-shrink: 0;
            padding-top: 2px;
            min-width: 80px;
        }
        .dt-admin-table td[colspan] { justify-content: center; }
        .dt-admin-table td[colspan]::before { display: none; }
    }
</style>

@{
    ViewBag.Title = "Receptionist Detail";
    string FormatEur(decimal v) => "€" + v.ToString("F2", CultureInfo.InvariantCulture);
    var d = Model.Dashboard;
}

<div class="dt-page-pad">

    <div class="dt-page-head">
        <div>
            <span class="eyebrow">Admin · Receptionist</span>
            <h1 style="font-size:44px;letter-spacing:-0.035em;font-weight:500;line-height:0.98;margin:14px 0 4px;color:var(--fg);">@(string.IsNullOrWhiteSpace(Model.ReceptionistName) ? Model.ReceptionistEmail : Model.ReceptionistName)</h1>
            <p style="margin:0;color:var(--fg-3);font-size:14px;">@Model.ReceptionistEmail</p>
        </div>
        <div class="dt-page-head-right">
            @Html.ActionLink("← Back", "Receptionists", "Admin", new { area = "" }, new { @class = "btn btn-ghost" })
        </div>
    </div>

    <!-- Earnings tiles -->
    <div class="dt-admin-tiles">
        <div class="dt-admin-tile">
            <span class="dt-admin-tile-k" style="color:#4ADE80;">@FormatEur(d.TotalEarned)</span>
            <span class="dt-admin-tile-l">Total Earned</span>
        </div>
        <div class="dt-admin-tile">
            <span class="dt-admin-tile-k" style="color:#67E8F9;">@FormatEur(d.TotalPaid)</span>
            <span class="dt-admin-tile-l">Paid Out</span>
        </div>
        <div class="dt-admin-tile">
            <span class="dt-admin-tile-k" style="color:#FACC15;">@FormatEur(d.TotalPending)</span>
            <span class="dt-admin-tile-l">Pending</span>
        </div>
        <div class="dt-admin-tile">
            <span class="dt-admin-tile-k" style="color:var(--fg-3);">@d.Codes.Count</span>
            <span class="dt-admin-tile-l">Codes Generated</span>
        </div>
    </div>

    <!-- Codes table -->
    <div class="dt-admin-table-section">
        <div class="dt-admin-table-head">
            <span style="color:var(--fg);">Referral Codes</span>
            <span class="dt-admin-table-badge">@d.Codes.Count</span>
        </div>
        <table class="dt-admin-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Status</th>
                    <th>Used By</th>
                    <th>Booking Date</th>
                    <th>Booking Status</th>
                    <th>Commission</th>
                    <th>Paid</th>
                </tr>
            </thead>
            <tbody>
                @if (!d.Codes.Any()) {
                    <tr><td colspan="7" style="text-align:center;color:var(--fg-3);">No codes yet</td></tr>
                }
                @foreach (var row in d.Codes) {
                    <tr>
                        <td data-label="Code">
                            <code style="font-family:var(--mono);font-size:14px;font-weight:600;color:var(--fg);letter-spacing:0.08em;">@row.Code</code>
                        </td>
                        <td data-label="Status">
                            @if (row.IsActive) {
                                <span style="color:#4ADE80;font-size:12px;">Active</span>
                            } else {
                                <span style="color:#F87171;font-size:12px;">Inactive</span>
                            }
                        </td>
                        <td data-label="Used By">
                            @if (row.UsedByEmail != null) {
                                <span style="font-size:13px;">@row.UsedByEmail</span>
                            } else {
                                <span style="color:var(--fg-3);">—</span>
                            }
                        </td>
                        <td data-label="Booking Date">
                            @if (row.BookingDate.HasValue) {
                                <span style="font-size:13px;">@row.BookingDate.Value.ToString("MMM d, yyyy · HH:mm")</span>
                            } else {
                                <span style="color:var(--fg-3);">—</span>
                            }
                        </td>
                        <td data-label="Booking Status">
                            @{
                                var statusColor = row.BookingStatus switch {
                                    "Approved"  => "#4ADE80",
                                    "Pending"   => "#FACC15",
                                    "Canceled"  => "#F87171",
                                    "Cancelled" => "#F87171",
                                    _           => "var(--fg-3)"
                                };
                            }
                            <span style="color:@statusColor;font-size:12px;">@row.BookingStatus</span>
                        </td>
                        <td data-label="Commission">
                            @if (row.CommissionAmount.HasValue) {
                                <span style="color:#4ADE80;font-weight:600;">@FormatEur(row.CommissionAmount.Value)</span>
                            } else {
                                <span style="color:var(--fg-3);">—</span>
                            }
                        </td>
                        <td data-label="Paid">
                            @if (!row.CommissionAmount.HasValue) {
                                <span style="color:var(--fg-3);">—</span>
                            } else if (row.CommissionPaid) {
                                <span style="color:#67E8F9;font-size:12px;" title="@row.CommissionPaidAt?.ToString("MMM d, yyyy")">Paid</span>
                            } else {
                                <span style="color:#FACC15;font-size:12px;">Pending</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
