@{
    ViewData["Title"] = "Privacy Policy";
    ViewBag.MetaDescription = "Privacy Policy for Taxi Blitz Ohrid — how we collect, use, and protect your personal data.";
    ViewBag.CanonicalUrl = "https://taxiblitzohrid.com/Home/Privacy";
}

<div class="dt-page-pad" style="max-width:720px;margin:0 auto;">
    <div style="padding:64px 0 80px;">
        <span style="font-family:var(--mono);font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:var(--fg-3);">Legal</span>
        <h1 style="font-size:clamp(32px,6vw,56px);font-weight:500;line-height:1;letter-spacing:-0.03em;margin:12px 0 40px;">
            Privacy <em class="serif-it">Policy</em>
        </h1>
        <p style="color:var(--fg-3);font-size:14px;margin-bottom:48px;">Last updated: June 1, 2026</p>

        <div style="display:flex;flex-direction:column;gap:36px;color:var(--fg-2);font-size:16px;line-height:1.7;">

            <section>
                <h2 style="font-size:20px;font-weight:500;color:var(--fg);margin-bottom:12px;">1. Who we are</h2>
                <p>Taxi Blitz Ohrid is a private taxi and tour service based in Ohrid, North Macedonia. Our website is <strong>taxiblitzohrid.com</strong>. You can contact us at <a href="mailto:zulirizvani@gmail.com" style="color:var(--fg);">zulirizvani@gmail.com</a> or <a href="tel:+38970589874" style="color:var(--fg);">+389 70 589 874</a>.</p>
            </section>

            <section>
                <h2 style="font-size:20px;font-weight:500;color:var(--fg);margin-bottom:12px;">2. What data we collect</h2>
                <p>When you use our website we may collect:</p>
                <ul style="padding-left:20px;margin-top:8px;">
                    <li><strong>Account data</strong> — name, email address and password (hashed) when you register.</li>
                    <li><strong>Booking data</strong> — your name, phone number, email, chosen tour, date, and number of people when you submit a booking.</li>
                    <li><strong>Reviews</strong> — your name and review text if you submit a review.</li>
                    <li><strong>Usage data</strong> — pages visited and actions taken, collected via Azure Application Insights for performance monitoring.</li>
                </ul>
            </section>

            <section>
                <h2 style="font-size:20px;font-weight:500;color:var(--fg);margin-bottom:12px;">3. How we use your data</h2>
                <ul style="padding-left:20px;">
                    <li>To process and confirm your tour bookings.</li>
                    <li>To send you booking confirmation and reminder emails.</li>
                    <li>To allow you to manage your account and bookings.</li>
                    <li>To monitor website performance and fix errors.</li>
                </ul>
                <p style="margin-top:12px;">We do <strong>not</strong> sell your data to third parties or use it for advertising.</p>
            </section>

            <section>
                <h2 style="font-size:20px;font-weight:500;color:var(--fg);margin-bottom:12px;">4. Data storage and security</h2>
                <p>Your data is stored on secure servers hosted via Microsoft Azure (EU region). Passwords are hashed using ASP.NET Core Identity (bcrypt). We use HTTPS for all data transmission.</p>
            </section>

            <section>
                <h2 style="font-size:20px;font-weight:500;color:var(--fg);margin-bottom:12px;">5. Third-party services</h2>
                <ul style="padding-left:20px;">
                    <li><strong>Azure Application Insights</strong> — performance monitoring.</li>
                    <li><strong>Google OAuth</strong> — optional sign-in via Google account.</li>
                    <li><strong>OpenWeatherMap</strong> — weather data shown on tour pages.</li>
                </ul>
            </section>

            <section>
                <h2 style="font-size:20px;font-weight:500;color:var(--fg);margin-bottom:12px;">6. Your rights</h2>
                <p>You have the right to access, correct, or delete your personal data at any time. To exercise these rights, contact us at <a href="mailto:zulirizvani@gmail.com" style="color:var(--fg);">zulirizvani@gmail.com</a>. We will respond within 30 days.</p>
            </section>

            <section>
                <h2 style="font-size:20px;font-weight:500;color:var(--fg);margin-bottom:12px;">7. Cookies</h2>
                <p>We use only essential cookies required for login sessions and security (anti-forgery tokens). We do not use tracking or advertising cookies.</p>
            </section>

            <section>
                <h2 style="font-size:20px;font-weight:500;color:var(--fg);margin-bottom:12px;">8. Changes to this policy</h2>
                <p>We may update this policy as the service evolves. The date at the top of this page reflects the most recent revision.</p>
            </section>

        </div>
    </div>
</div>
