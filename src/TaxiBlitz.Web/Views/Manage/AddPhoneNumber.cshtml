@model AddPhoneNumberViewModel
@{
    ViewBag.Title = "Phone number";
}

<div class="dt-page-pad">
    <div class="dt-page-head">
        <div>
            <span class="eyebrow">Account</span>
            <h1 style="font-size:48px;letter-spacing:-0.035em;font-weight:500;line-height:0.98;margin:14px 0 0;color:var(--fg);">Phone <em class="serif-it">number</em></h1>
        </div>
    </div>

    <div style="margin:0 80px 64px;max-width:480px;">
        <div class="dt-form-card">
            @using (Html.BeginForm("AddPhoneNumber", "Manage", FormMethod.Post, new { role = "form" })) {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "validation-summary-errors" })

                <div class="dt-field">
                    <label>Phone number</label>
                    <div class="dt-phone-row">
                        <select id="addPhonePrefix" class="dt-phone-prefix"></select>
                        <input id="addPhoneCustom" type="text" placeholder="+XX" class="dt-phone-custom" style="display:none;">
                        <input id="addPhoneLocal" type="tel" placeholder="70 000 000" class="dt-phone-local">
                    </div>
                    <input type="hidden" id="Number" name="Number" />
                    @Html.ValidationMessageFor(m => m.Number, "", new { @class = "field-validation-error" })
                </div>

                <button type="submit" class="dt-auth-submit" style="margin-top:8px;">
                    Save number
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validate/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validate-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="@Url.Content("~/js/phone-prefix.js")"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            initPhonePrefix({
                formSel:   'form',
                selectSel: '#addPhonePrefix',
                customSel: '#addPhoneCustom',
                localSel:  '#addPhoneLocal',
                hiddenSel: '#Number'
            });
        });
    </script>
}

