@model SetPasswordViewModel
@{
    ViewBag.Title = "Set password";
}

<div class="dt-page-pad">
    <div class="dt-page-head">
        <div>
            <span class="eyebrow">Account</span>
            <h1 style="font-size:48px;letter-spacing:-0.035em;font-weight:500;line-height:0.98;margin:14px 0 0;color:var(--fg);">Set a <em class="serif-it">password</em></h1>
        </div>
    </div>

    <div style="margin:0 80px 64px;max-width:480px;">
        <p style="font-size:14px;color:var(--fg-3);margin-bottom:24px;">
            Your account was created via an external provider. Add a local password so you can also sign in with your email address directly.
        </p>
        <div class="dt-form-card">
            @using (Html.BeginForm("SetPassword", "Manage", FormMethod.Post, new { role = "form" })) {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "validation-summary-errors" })

                <div class="dt-field">
                    @Html.LabelFor(m => m.NewPassword)
                    @Html.PasswordFor(m => m.NewPassword, new { placeholder = "New password", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-validation-error" })
                </div>
                <div class="dt-field">
                    @Html.LabelFor(m => m.ConfirmPassword)
                    @Html.PasswordFor(m => m.ConfirmPassword, new { placeholder = "Confirm password", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
                </div>

                <button type="submit" class="dt-auth-submit" style="margin-top:8px;">
                    Set password
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validate/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validate-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

