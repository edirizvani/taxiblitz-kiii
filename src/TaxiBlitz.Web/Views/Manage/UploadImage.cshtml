@{
    ViewBag.Title = "Upload Image";
}

<style>
    /* ===== Page wrapper ===== */
    .upload-page {
        padding: 1.75rem 0 3rem;
        min-height: 60vh;
    }

    /* ===== Section heading ===== */
    .upload-section-title {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 500;
        color: var(--fg);
        margin-bottom: 0.35rem;
        letter-spacing: -0.02em;
    }

    .upload-section-sub {
        color: var(--fg-3);
        font-size: 0.95rem;
        margin-bottom: 1.75rem;
    }

    /* ===== Drag-and-drop zone ===== */
    .drop-zone-wrapper {
        position: relative;
        border-radius: 1.5rem;
        background: linear-gradient(135deg, #0a1628 0%, #0f2d4a 55%, #0c3d5c 100%);
        padding: 2px;
        box-shadow: 0 24px 60px rgba(0, 123, 255, 0.18), 0 6px 18px rgba(0,0,0,0.14);
        margin-bottom: 1.75rem;
    }

    .drop-zone-inner {
        border-radius: calc(1.5rem - 2px);
        background: linear-gradient(135deg, #0a1628 0%, #0f2d4a 55%, #0c3d5c 100%);
        padding: 2.5rem 2rem;
        position: relative;
        overflow: hidden;
    }

    /* Dot-grid background pattern */
    .drop-zone-inner::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255,255,255,0.055) 1px, transparent 1px);
        background-size: 26px 26px;
        pointer-events: none;
        border-radius: inherit;
    }

    /* ===== Dashed upload target ===== */
    .drop-target {
        position: relative;
        border: 2px dashed rgba(0, 210, 255, 0.35);
        border-radius: 1.15rem;
        padding: 2.75rem 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.25s ease, background 0.25s ease;
        background: rgba(0, 180, 255, 0.04);
        animation: dashRotate 18s linear infinite;
    }

    @@keyframes dashRotate {
        0%   { border-color: rgba(0,210,255,0.35); }
        50%  { border-color: rgba(0,123,255,0.55); }
        100% { border-color: rgba(0,210,255,0.35); }
    }

    .drop-target.dragover {
        border-color: #00d2ff;
        background: rgba(0, 210, 255, 0.10);
        animation: none;
    }

    .drop-target.file-selected {
        border-color: #22c55e;
        background: rgba(34, 197, 94, 0.06);
        animation: none;
    }

    .drop-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 1.1rem;
        color: #00d2ff;
        opacity: 0.85;
    }

    .drop-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #e2e8f0;
        margin-bottom: 0.4rem;
    }

    .drop-subtitle {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.45);
        margin-bottom: 1.4rem;
    }

    .drop-browse-btn {
        display: inline-block;
        background: linear-gradient(135deg, #007bff, #00d2ff);
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.65rem 1.5rem;
        border-radius: 999px;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 16px rgba(0,123,255,0.3);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .drop-browse-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 22px rgba(0,123,255,0.42);
    }

    .drop-file-name {
        display: none;
        margin-top: 1rem;
        font-size: 0.88rem;
        color: #22c55e;
        font-weight: 600;
    }

    #imageFile { display: none; }

    /* Submit button row */
    .upload-submit-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }

    .upload-submit-btn {
        background: linear-gradient(135deg, #0f766e, #2563eb);
        color: #fff;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.8rem 2rem;
        border-radius: 999px;
        border: none;
        cursor: pointer;
        box-shadow: 0 4px 18px rgba(15,118,110,0.32);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        min-height: 48px;
    }

    .upload-submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 26px rgba(15,118,110,0.46);
    }

    .upload-hint {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.4);
    }

    /* ===== Alerts ===== */
    .upload-alert {
        border-radius: 0.9rem;
        padding: 0.9rem 1.2rem;
        margin-bottom: 1.25rem;
        font-size: 0.92rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    /* ===== Gallery heading ===== */
    .gallery-heading {
        font-size: 1.25rem;
        font-weight: 500;
        color: var(--fg);
        margin-bottom: 0.25rem;
        letter-spacing: -0.02em;
    }

    .gallery-count {
        font-size: 0.85rem;
        color: var(--fg-3);
        margin-bottom: 1.25rem;
    }

    /* ===== Masonry-inspired gallery grid ===== */
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        grid-auto-rows: 200px;
        gap: 0.9rem;
    }

    /* Every 7th tile spans 2 columns for variety */
    .gallery-tile:nth-child(7n+1) {
        grid-column: span 2;
    }

    .gallery-tile {
        position: relative;
        border-radius: 1rem;
        overflow: hidden;
        background: var(--ink-3);
        box-shadow: 0 8px 24px rgba(15,23,42,0.10);
        transition: transform 0.28s ease, box-shadow 0.28s ease;
        cursor: pointer;
    }

    .gallery-tile:hover {
        transform: translateY(-4px) scale(1.015);
        box-shadow: 0 18px 40px rgba(15,23,42,0.16);
        z-index: 2;
    }

    .gallery-tile img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.35s ease;
    }

    .gallery-tile:hover img {
        transform: scale(1.05);
    }

    /* Hover overlay */
    .gallery-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(10,22,40,0.88) 0%, rgba(10,22,40,0.2) 55%, transparent 100%);
        opacity: 0;
        transition: opacity 0.25s ease;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0.85rem 1rem;
    }

    .gallery-tile:hover .gallery-overlay {
        opacity: 1;
    }

    .gallery-overlay-name {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.75);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.5rem;
    }

    .gallery-overlay-actions {
        display: flex;
        gap: 0.45rem;
    }

    .overlay-btn {
        border: none;
        border-radius: 0.5rem;
        padding: 0.38rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.18s ease;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .overlay-btn-view {
        background: rgba(255,255,255,0.18);
        color: #fff;
        backdrop-filter: blur(4px);
    }

    .overlay-btn-view:hover {
        background: rgba(255,255,255,0.32);
    }

    .overlay-btn-delete {
        background: rgba(239,68,68,0.82);
        color: #fff;
    }

    .overlay-btn-delete:hover {
        background: rgba(220,38,38,0.95);
    }

    /* ===== Lightbox ===== */
    .lightbox-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(5,10,22,0.93);
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        backdrop-filter: blur(6px);
    }

    .lightbox-backdrop.open {
        display: flex;
    }

    .lightbox-img {
        max-width: 90vw;
        max-height: 88vh;
        border-radius: 1rem;
        box-shadow: 0 30px 80px rgba(0,0,0,0.6);
        object-fit: contain;
        display: block;
    }

    .lightbox-close {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        background: rgba(255,255,255,0.12);
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        font-size: 1.25rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
        backdrop-filter: blur(4px);
    }

    .lightbox-close:hover { background: rgba(255,255,255,0.22); }

    /* ===== Empty state ===== */
    .empty-gallery {
        text-align: center;
        padding: 3.5rem 1rem;
        color: #94a3b8;
    }

    .empty-gallery svg {
        width: 72px;
        height: 72px;
        opacity: 0.35;
        margin-bottom: 1rem;
    }

    .empty-gallery p {
        font-size: 0.95rem;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 767px) {
        .gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            grid-auto-rows: 160px;
            gap: 0.7rem;
        }

        .gallery-tile:nth-child(7n+1) {
            grid-column: span 1;
        }

        .drop-zone-inner { padding: 1.75rem 1.25rem; }
        .drop-target { padding: 2rem 1rem; }
    }

    @@media (max-width: 575px) {
        .gallery-grid {
            grid-template-columns: repeat(2, 1fr);
            grid-auto-rows: 140px;
            gap: 0.6rem;
        }

        .upload-submit-row { flex-direction: column; align-items: stretch; }
        .upload-submit-btn { width: 100%; }
        .drop-title { font-size: 1rem; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .drop-target { animation: none; }
        .gallery-tile, .gallery-tile img { transition: none; }
    }
</style>

<div class="dt-page-pad upload-page" style="padding-bottom:64px;">

    <!-- Page heading -->
    <p class="upload-section-title">Image Gallery</p>
    <p class="upload-section-sub">Upload and manage photos for the public gallery. Images appear instantly after upload.</p>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="upload-alert alert-success">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="upload-alert alert-danger">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Upload zone -->
    <div class="drop-zone-wrapper">
        <div class="drop-zone-inner">
            @using (Html.BeginForm("UploadImage", "Manage", FormMethod.Post, new { enctype = "multipart/form-data", id = "uploadForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="drop-target" id="dropTarget" role="button" tabindex="0" aria-label="Click or drag to upload an image">
                    <!-- Cloud upload icon -->
                    <svg class="drop-icon" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                        <polyline points="16 16 12 12 8 16"/>
                        <line x1="12" y1="12" x2="12" y2="21"/>
                        <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
                    </svg>
                    <p class="drop-title">Drag &amp; drop your image here</p>
                    <p class="drop-subtitle">Supports JPG, PNG, WEBP, GIF &mdash; max 10 MB</p>
                    <span class="drop-browse-btn" id="browseBtn">Browse file</span>
                    <p class="drop-file-name" id="dropFileName"></p>
                    <input type="file" id="imageFile" name="imageFile" accept="image/*" required />
                </div>

                <div class="upload-submit-row">
                    <button type="submit" class="upload-submit-btn" id="submitBtn" disabled>
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true" style="margin-right:7px;vertical-align:middle;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        Upload to Gallery
                    </button>
                    <span class="upload-hint">Image will be published to the public gallery immediately.</span>
                </div>
            }
        </div>
    </div>

    <!-- Gallery grid -->
    @{
        string galleryDir = System.IO.Path.Combine(Context.RequestServices.GetRequiredService<Microsoft.AspNetCore.Hosting.IWebHostEnvironment>().WebRootPath, "gallery");
        bool dirExists = Directory.Exists(galleryDir);
        string[] files = dirExists ? Directory.GetFiles(galleryDir) : new string[0];
    }

    <p class="gallery-heading">Uploaded Images</p>
    <p class="gallery-count">@files.Length image@(files.Length == 1 ? "" : "s") in the gallery</p>

    @if (files.Length > 0)
    {
        <div class="gallery-grid" id="galleryGrid">
            @foreach (var file in files)
            {
                string fname = System.IO.Path.GetFileName(file);
                string src = Url.Content("~/gallery/" + fname);
                <div class="gallery-tile" data-filename="@fname">
                    <img src="@src" alt="@fname" loading="lazy" />
                    <div class="gallery-overlay">
                        <span class="gallery-overlay-name">@fname</span>
                        <div class="gallery-overlay-actions">
                            <button class="overlay-btn overlay-btn-view js-lightbox" data-src="@src" type="button" aria-label="View full image">
                                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                View
                            </button>
                            <button class="overlay-btn overlay-btn-delete js-delete" data-filename="@fname" type="button" aria-label="Delete @fname">
                                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-gallery">
            <svg fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
            </svg>
            <p>No images uploaded yet. Drag &amp; drop or browse to get started.</p>
        </div>
    }
</div>

<!-- Lightbox -->
<div class="lightbox-backdrop" id="lightbox" role="dialog" aria-modal="true" aria-label="Image preview">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close preview">&times;</button>
    <img class="lightbox-img" id="lightboxImg" src="" alt="Preview" />
</div>

@section scripts {
<script>
(function () {
    // ===== Drag & drop / file input =====
    var dropTarget  = document.getElementById('dropTarget');
    var fileInput   = document.getElementById('imageFile');
    var browseBtn   = document.getElementById('browseBtn');
    var fileNameEl  = document.getElementById('dropFileName');
    var submitBtn   = document.getElementById('submitBtn');

    function setFile(name) {
        fileNameEl.textContent = 'âœ“ ' + name;
        fileNameEl.style.display = 'block';
        dropTarget.classList.add('file-selected');
        dropTarget.classList.remove('dragover');
        submitBtn.disabled = false;
    }

    browseBtn.addEventListener('click', function (e) { e.stopPropagation(); fileInput.click(); });
    dropTarget.addEventListener('click', function () { fileInput.click(); });
    dropTarget.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') fileInput.click(); });

    fileInput.addEventListener('change', function () {
        if (this.files && this.files[0]) setFile(this.files[0].name);
    });

    dropTarget.addEventListener('dragover', function (e) {
        e.preventDefault();
        this.classList.add('dragover');
    });

    dropTarget.addEventListener('dragleave', function () {
        this.classList.remove('dragover');
    });

    dropTarget.addEventListener('drop', function (e) {
        e.preventDefault();
        var dt = e.dataTransfer;
        if (dt && dt.files && dt.files[0]) {
            fileInput.files = dt.files;
            setFile(dt.files[0].name);
        }
    });

    // ===== Lightbox =====
    var lightbox     = document.getElementById('lightbox');
    var lightboxImg  = document.getElementById('lightboxImg');
    var lightboxClose = document.getElementById('lightboxClose');

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.js-lightbox');
        if (btn) {
            lightboxImg.src = btn.dataset.src;
            lightbox.classList.add('open');
        }
    });

    function closeLightbox() {
        lightbox.classList.remove('open');
        lightboxImg.src = '';
    }

    lightboxClose.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', function (e) { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLightbox(); });

    // ===== AJAX delete =====
    var token = $('input[name="__RequestVerificationToken"]').first().val();

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.js-delete');
        if (!btn) return;

        var filename = btn.dataset.filename;
        if (!filename) return;

        if (!confirm('Delete "' + filename + '"? This cannot be undone.')) return;

        var tile = btn.closest('.gallery-tile');

        $.ajax({
            url: '@Url.Action("DeleteImage", "Manage")',
            type: 'POST',
            data: { fileName: filename, __RequestVerificationToken: token },
            success: function (res) {
                if (res && res.success) {
                    tile.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
                    tile.style.opacity = '0';
                    tile.style.transform = 'scale(0.88)';
                    setTimeout(function () {
                        tile.remove();
                        var remaining = document.querySelectorAll('.gallery-tile').length;
                        var countEl = document.querySelector('.gallery-count');
                        if (countEl) countEl.textContent = remaining + ' image' + (remaining === 1 ? '' : 's') + ' in the gallery';
                    }, 350);
                } else {
                    alert((res && res.message) ? res.message : 'Could not delete the image. Please try again.');
                }
            },
            error: function () {
                alert('Network error â€” could not delete the image.');
            }
        });
    });
}());
</script>
}
