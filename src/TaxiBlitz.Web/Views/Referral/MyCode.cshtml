@using TaxiBlitz.Domain.Entities
@model ReferralCode
@{
    ViewBag.Title = "My Referral Code";
    var shareText = Uri.EscapeDataString($"Use my referral code {Model.Code} to get {Model.DiscountPercent}% off any tour at TaxiBlitz Ohrid!");
    var waLink = $"https://wa.me/?text={shareText}";
}

<style>
    @@media (max-width: 480px) {
        .dt-page-pad {
            padding: 24px 16px 32px;
        }

        .dt-page-head {
            margin-bottom: 24px;
            gap: 16px;
        }

        .dt-page-head h1 {
            font-size: 34px !important;
            line-height: 1.02 !important;
            margin-top: 10px !important;
        }

        .dt-page-head-sub {
            font-size: 14px;
            line-height: 1.55;
        }

        .dt-page-head-right .btn,
        .dt-page-head-right a {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="dt-page-pad">
    <div class="dt-page-head">
        <div>
            <span class="eyebrow">Account</span>
            <h1 style="font-size:64px;letter-spacing:-0.035em;font-weight:500;line-height:0.98;margin:14px 0 0;color:var(--fg);">My <em class="serif-it">referral code</em></h1>
            <p class="dt-page-head-sub">Share your code and friends get @Model.DiscountPercent% off their first booking.</p>
        </div>
        <div class="dt-page-head-right">
            <a href="@Url.Action("Index","Tours")" class="btn btn-ghost">Browse tours</a>
        </div>
    </div>

    <div style="margin:0 80px;display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:900px;" class="dt-referral-grid">
        <!-- Code card -->
        <div style="background:var(--ink-2);border:1px solid var(--line);border-radius:24px;padding:40px;text-align:center;" class="dt-referral-card">
            <p style="font-size:12px;font-family:var(--mono);letter-spacing:0.12em;text-transform:uppercase;color:var(--fg-3);margin:0 0 16px;">Your code</p>
            <div id="referralCode" style="font-size:36px;font-weight:700;letter-spacing:0.08em;color:var(--lime);font-family:var(--mono);margin-bottom:24px;word-break:break-word;">@Model.Code</div>
            <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;" class="dt-referral-actions">
                <button onclick="tbCopyToClipboard('@Model.Code', this)"
                        class="dt-referral-action-btn"
                        style="background:var(--ink-3);border:1px solid var(--line);border-radius:12px;padding:10px 20px;font-size:13px;color:var(--fg);cursor:pointer;display:flex;align-items:center;gap:8px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    Copy
                </button>
                <a href="@waLink" target="_blank" rel="noopener"
                         class="dt-referral-action-btn"
                   style="background:#25D366;border:1px solid rgba(255,255,255,0.1);border-radius:12px;padding:10px 20px;font-size:13px;color:#fff;text-decoration:none;display:flex;align-items:center;gap:8px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.885 3.488"/></svg>
                    Share on WhatsApp
                </a>
            </div>
        </div>

        <!-- Stats card -->
        <div style="background:var(--ink-2);border:1px solid var(--line);border-radius:24px;padding:40px;" class="dt-referral-card">
            <p style="font-size:12px;font-family:var(--mono);letter-spacing:0.12em;text-transform:uppercase;color:var(--fg-3);margin:0 0 20px;">Your stats</p>
            <div style="display:flex;flex-direction:column;gap:16px;">
                <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);">
                    <span style="font-size:14px;color:var(--fg-2);">Discount rate</span>
                    <span style="font-size:20px;font-weight:600;color:var(--lime);">@Model.DiscountPercent%</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);">
                    <span style="font-size:14px;color:var(--fg-2);">Times used</span>
                    <span style="font-size:20px;font-weight:600;color:var(--fg);">@Model.UsageCount</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 0;">
                    <span style="font-size:14px;color:var(--fg-2);">Status</span>
                    <span style="font-size:13px;font-weight:500;color:@(Model.IsActive ? "var(--lime)" : "var(--fg-3)");">@(Model.IsActive ? "Active" : "Inactive")</span>
                </div>
            </div>
        </div>
    </div>

    <div style="margin:24px 80px 0;background:rgba(103,232,249,0.06);border:1px solid rgba(103,232,249,0.18);border-radius:16px;padding:20px 24px;max-width:900px;" class="dt-referral-note">
        <p style="font-size:14px;color:var(--fg-2);margin:0;line-height:1.65;">
            Share your code with friends. When they use it at checkout they get <strong style="color:var(--lime);">@Model.DiscountPercent% off</strong> their booking. You cannot use your own code.
        </p>
    </div>
</div>

<style>
    @@media (max-width: 640px) {
        .dt-referral-grid {
            margin: 0 !important;
            padding: 0 16px !important;
            grid-template-columns: 1fr !important;
            gap: 16px !important;
            max-width: none !important;
        }

        .dt-referral-card {
            padding: 24px 18px !important;
            border-radius: 20px !important;
        }

        #referralCode {
            font-size: 28px !important;
            margin-bottom: 18px !important;
        }

        .dt-referral-actions {
            flex-direction: column !important;
            align-items: stretch !important;
        }

        .dt-referral-action-btn {
            width: 100% !important;
            justify-content: center !important;
        }

        .dt-referral-note {
            margin: 16px 16px 0 !important;
            padding: 16px 18px !important;
            max-width: none !important;
            border-radius: 14px !important;
        }
    }
</style>
