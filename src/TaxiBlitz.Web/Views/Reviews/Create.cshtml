@model Review

@{
    ViewBag.Title = "Add Review";
}

<div class="dt-page-pad">
    <div class="dt-page-head">
        <div>
            <span class="eyebrow">Admin</span>
            <h1 style="font-size:48px;letter-spacing:-0.035em;font-weight:500;line-height:0.98;margin:14px 0 0;color:var(--fg);">New <em class="serif-it">review</em></h1>
        </div>
        <div class="dt-page-head-right">
            @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-ghost" })
        </div>
    </div>
    <div style="margin:0 80px 64px;max-width:560px;">
        <div class="dt-form-card">
            @using (Html.BeginForm()) {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
                <div class="dt-field">
                    @Html.LabelFor(m => m.ReviewerName)
                    @Html.EditorFor(m => m.ReviewerName, new { htmlAttributes = new { placeholder = "Reviewer name" } })
                    @Html.ValidationMessageFor(m => m.ReviewerName, "", new { @class = "field-validation-error" })
                </div>
                <div class="dt-field">
                    @Html.LabelFor(m => m.Text)
                    @Html.TextAreaFor(m => m.Text, new { placeholder = "Review text", rows = "4" })
                    @Html.ValidationMessageFor(m => m.Text, "", new { @class = "field-validation-error" })
                </div>
                <div class="dt-field">
                    @Html.LabelFor(m => m.ReviewDate)
                    @Html.EditorFor(m => m.ReviewDate)
                    @Html.ValidationMessageFor(m => m.ReviewDate, "", new { @class = "field-validation-error" })
                </div>
                <div class="dt-field">
                    @Html.LabelFor(m => m.ImageUrl)
                    @Html.EditorFor(m => m.ImageUrl, new { htmlAttributes = new { placeholder = "Reviewer photo URL" } })
                    @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "field-validation-error" })
                </div>
                <button type="submit" class="dt-auth-submit" style="margin-top:8px;">
                    Create review
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
            }
        </div>
    </div>
</div>

