@{
    ViewBag.Title = "Page Not Found";
}

<div class="dt-page-pad" style="min-height:60vh;display:flex;align-items:center;justify-content:center;">
    <div style="text-align:center;max-width:520px;">
        <p style="font-family:var(--mono);font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:var(--fg-3);margin-bottom:16px;">404</p>
        <h1 style="font-size:clamp(40px,8vw,72px);font-weight:500;line-height:0.98;letter-spacing:-0.035em;margin-bottom:20px;">
            Page <em class="serif-it">not found.</em>
        </h1>
        <p style="color:var(--fg-3);font-size:16px;line-height:1.6;margin-bottom:36px;">
            The page you're looking for doesn't exist or has been moved.
            Let's get you back on track.
        </p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
            <a href="/" class="btn btn-primary">Go home</a>
            <a href="/Tours" class="btn btn-ghost">Browse tours</a>
        </div>
    </div>
</div>
