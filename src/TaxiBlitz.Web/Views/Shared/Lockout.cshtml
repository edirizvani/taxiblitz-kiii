@{
    ViewBag.Title = "Account locked";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lockoutEnd = ViewBag.LockoutEnd as string;
}

<style>
    .tb-body { padding-top: 0 !important; }
</style>

<div class="dt-auth">
    <div class="dt-auth-left">
        <div class="dt-auth-content">
            <div class="dt-auth-brand">
                <a class="dt-brand" href="@Url.Action("Index","Home")">
                    <span class="dt-brand-mark"><span class="dt-brand-mark-dot"></span></span>
                    <span class="dt-brand-text">TaxiBlitz <em class="serif-it">Ohrid</em></span>
                </a>
            </div>
            <div class="dt-auth-card">
                <div style="text-align:center;margin-bottom:24px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="width:56px;height:56px;">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <h2 class="dt-auth-h" style="text-align:center;">Account<br><em class="serif-it">locked.</em></h2>
                <p class="dt-auth-sub" style="text-align:center;">
                    Too many failed sign-in attempts. Your account has been temporarily locked for security.
                </p>

                @if (!string.IsNullOrEmpty(lockoutEnd))
                {
                    <div id="lockout-timer" style="text-align:center;margin:16px 0;padding:16px;background:rgba(248,113,113,0.07);border:1px solid rgba(248,113,113,0.18);border-radius:14px;">
                        <div style="font-size:11px;font-family:var(--mono);letter-spacing:0.1em;text-transform:uppercase;color:var(--fg-3);margin-bottom:6px;">Try again in</div>
                        <div id="countdown" style="font-size:36px;font-weight:500;letter-spacing:-0.02em;color:var(--fg);font-family:var(--sans);">--:--</div>
                    </div>
                }
                else
                {
                    <p style="color:#888;font-size:13px;text-align:center;margin-top:8px;">Please wait a few minutes before trying again.</p>
                }

                <div id="try-again-btn" style="margin-top:24px;text-align:center;display:none;">
                    <a href="@Url.Action("Login","Account")" class="dt-auth-submit" style="display:inline-flex;text-decoration:none;">
                        Try signing in again
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </a>
                </div>
                <div style="margin-top:16px;text-align:center;">
                    <a href="@Url.Action("ForgotPassword","Account")" class="dt-auth-link">
                        Forgot your password?
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="dt-auth-right">
        <div class="dt-auth-photo"></div>
        <div class="dt-auth-photo-overlay"></div>
        <div class="dt-auth-photo-quote">
            "Even the strongest storms pass — <em>come back in a moment.</em>"
            <div class="dt-auth-photo-author">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13Z"/><circle cx="12" cy="9" r="2.5"/></svg>
                TaxiBlitz Ohrid
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(lockoutEnd))
{
    <script>
        (function () {
            var endTime = new Date('@Html.Raw(lockoutEnd)').getTime();
            var display = document.getElementById('countdown');
            var timerBox = document.getElementById('lockout-timer');
            var tryBtn   = document.getElementById('try-again-btn');

            function tick() {
                var remaining = endTime - Date.now();
                if (remaining <= 0) {
                    if (display)  display.textContent = '0:00';
                    if (timerBox) timerBox.style.display = 'none';
                    if (tryBtn)   tryBtn.style.display = 'block';
                    return;
                }
                var m = Math.floor(remaining / 60000);
                var s = Math.floor((remaining % 60000) / 1000);
                if (display) display.textContent = m + ':' + (s < 10 ? '0' : '') + s;
                setTimeout(tick, 1000);
            }
            tick();

            // Also show the try-again button immediately if lockout has already expired
            if (endTime - Date.now() <= 0) {
                if (timerBox) timerBox.style.display = 'none';
                if (tryBtn)   tryBtn.style.display = 'block';
            }
        })();
    </script>
}
else
{
    <script>
        document.getElementById('try-again-btn').style.display = 'block';
    </script>
}
