<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Taxi Blitz Ohrid</title>
    @{
        var _metaDesc    = ViewBag.MetaDescription as string ?? "Private taxi tours, airport transfers and day trips around Ohrid, North Macedonia. Book with Taxi Blitz Ohrid — 25+ years of local expertise, available 24/7.";
        var _canonical   = ViewBag.CanonicalUrl   as string ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var _ogTitle     = ViewBag.Title != null ? ViewBag.Title + " - Taxi Blitz Ohrid" : "Taxi Blitz Ohrid — Private Tours & Airport Transfers";
        var _ogImage     = ViewBag.OgImage as string ?? "https://taxiblitzohrid.com/img/og-image.jpg";
    }
    <meta name="description" content="@_metaDesc" />
    <link rel="canonical" href="@_canonical" />
    <!-- PWA -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#0B100E" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Taxi Blitz Ohrid" />
    <meta property="og:title" content="@_ogTitle" />
    <meta property="og:description" content="@_metaDesc" />
    <meta property="og:image" content="@_ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="@_canonical" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@_ogTitle" />
    <meta name="twitter:description" content="@_metaDesc" />
    <meta name="twitter:image" content="@_ogImage" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TaxiBlitz" />
    <!-- Favicon — adaptive SVG (dark/light via prefers-color-scheme), PNG fallbacks, ICO for legacy -->
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="~/img/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/img/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="~/img/favicon-512.png" />
    <!-- Theme anti-FOUC -->
    <script>(function(){var t=localStorage.getItem('tb-theme');if(t==='light')document.documentElement.setAttribute('data-theme','light');})()</script>
    <link rel="stylesheet" href="~/css/taxiblitz-design.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    @Html.Partial("Seo/_GlobalStructuredData")
    @Html.Partial("Seo/_BreadcrumbStructuredData")
    @RenderSection("Head", required: false)
</head>
<body>

<!-- â”€â”€ NAVBAR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
<header class="dt-nav">
    <div class="dt-nav-inner">
        <a class="dt-brand" href="@Url.Action("Index","Home")">
            <span class="dt-brand-mark"><span class="dt-brand-mark-dot"></span></span>
            <span class="dt-brand-text">TaxiBlitz <em class="serif-it">Ohrid</em></span>
        </a>

        <nav class="dt-nav-links">
            @Html.ActionLink("Home",       "Index",              "Home",         new { area = "" }, null)
            @Html.ActionLink("Tours",      "Index",              "Tours",        new { area = "" }, null)
            @Html.ActionLink("Drivers",    "Index",              "Drivers",      new { area = "" }, null)
            @Html.ActionLink("Stories",    "Index",              "TourStories",  new { area = "" }, null)
            @Html.ActionLink("Gallery",    "Gallery",            "Manage",       new { area = "" }, null)
            @if (User.IsInRole("Administrator") || User.IsInRole("User")) {
                @Html.ActionLink("My Bookings", "UserBookings",  "BookingTours", new { area = "" }, null)
            }
            @if (User.IsInRole("Driver")) {
                @Html.ActionLink("Scheduler", "DriverScheduler", "BookingTours", new { area = "" }, null)
            }
            @if (User.IsInRole("Receptionist")) {
                @Html.ActionLink("Dashboard", "Dashboard", "Receptionist", new { area = "" }, null)
            }
            @if (User.IsInRole("Administrator")) {
                @Html.ActionLink("Dashboard",      "AdministratorIndex", "BookingTours", new { area = "" }, null)
                @Html.ActionLink("Receptionists",  "Receptionists",      "Admin",        new { area = "" }, null)
                @Html.ActionLink("My Codes",       "AdminCodes",         "Admin",        new { area = "" }, null)
                @Html.ActionLink("Stories",        "Management",         "TourStories",  new { area = "" }, null)
                @Html.ActionLink("Upload",         "Uploadimage",        "Manage",       new { area = "" }, null)
                @Html.ActionLink("Roles",          "addusertorole",      "account",      new { area = "" }, null)
            }
        </nav>

        <div class="dt-nav-right">
            <!-- Language switcher -->
            <!-- Theme toggle -->
            <button class="dt-theme-toggle" onclick="tbToggleTheme()" title="Toggle light/dark mode" type="button">
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z"/></svg>
                <svg class="icon-sun"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            </button>
            @if (!User.Identity.IsAuthenticated) {
                <a href="@Url.Action("Login","Account")" class="dt-nav-signin">Sign in</a>
            } else {
                <div class="dt-nav-user" id="navUserMenu">
                    <button class="dt-nav-user-btn" id="navUserBtn" type="button" aria-haspopup="true" aria-expanded="false">
                        <span class="dt-nav-user-avatar">@User.Identity.Name.Substring(0,1).ToUpper()</span>
                        <span class="dt-nav-user-name">@User.Identity.Name</span>
                        <svg class="dt-nav-user-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                    </button>
                    <div class="dt-nav-user-dropdown" id="navUserDropdown">
                        @Html.ActionLink("Edit profile",      "EditProfile", "Manage",       new { area = "" }, new { @class = "dt-nav-user-item" })
                        @Html.ActionLink("Account settings",  "Index",       "Manage",       new { area = "" }, new { @class = "dt-nav-user-item" })
                        @if (User.IsInRole("Administrator") || User.IsInRole("User")) {
                            @Html.ActionLink("My Bookings",   "UserBookings", "BookingTours", new { area = "" }, new { @class = "dt-nav-user-item" })
                            @Html.ActionLink("My Wishlist",   "MyWishlist",   "Favourites",   new { area = "" }, new { @class = "dt-nav-user-item" })
                            @Html.ActionLink("Referral Code", "MyCode",       "Referral",     new { area = "" }, new { @class = "dt-nav-user-item" })
                        }
                        @if (User.IsInRole("Receptionist")) {
                            @Html.ActionLink("My Dashboard", "Dashboard", "Receptionist", new { area = "" }, new { @class = "dt-nav-user-item" })
                        }
                        @if (User.IsInRole("Driver")) {
                            @Html.ActionLink("My Schedule", "DriverScheduler", "BookingTours", new { area = "" }, new { @class = "dt-nav-user-item" })
                        }
                        <div class="dt-nav-user-sep"></div>
                        @using (Html.BeginForm("LogOff","Account",FormMethod.Post, new { style="margin:0" })) {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dt-nav-user-item dt-nav-user-signout">Sign out</button>
                        }
                    </div>
                </div>
            }
            <a href="@Url.Action("Create","BookingTours")" class="dt-nav-book">
                Book a tour
                <span class="dt-nav-book-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
            </a>
            <button class="dt-nav-toggle" id="navToggle" aria-label="Open menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
            </button>
        </div>
    </div>
</header>

