@model Tour

@{
    ViewBag.Title = "Edit Tour";
}

<div class="dt-page-pad">
    <div class="dt-page-head">
        <div>
            <span class="eyebrow">Admin</span>
            <h1 style="font-size:48px;letter-spacing:-0.035em;font-weight:500;line-height:0.98;margin:14px 0 0;color:var(--fg);">Edit <em class="serif-it">tour</em></h1>
        </div>
        <div class="dt-page-head-right">
            @Html.ActionLink("Back to tours", "Index", null, new { @class = "btn btn-ghost" })
        </div>
    </div>

    <div style="margin:0 80px 64px;max-width:720px;">
        <div class="dt-form-card">
            @using (Html.BeginForm()) {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
                @Html.HiddenFor(m => m.Id)

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                    <div class="dt-field" style="grid-column:1/-1;">
                        @Html.LabelFor(m => m.Title)
                        @Html.EditorFor(m => m.Title)
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field" style="grid-column:1/-1;">
                        @Html.LabelFor(m => m.Description)
                        @Html.TextAreaFor(m => m.Description, new { rows = "4" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field" style="margin:0;">
                        @Html.LabelFor(m => m.Price)
                        @Html.EditorFor(m => m.Price)
                        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field" style="margin:0;">
                        @Html.LabelFor(m => m.Duration)
                        @Html.EditorFor(m => m.Duration)
                        @Html.ValidationMessageFor(m => m.Duration, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field" style="margin:0;">
                        @Html.LabelFor(m => m.StartingPoint)
                        @Html.EditorFor(m => m.StartingPoint)
                        @Html.ValidationMessageFor(m => m.StartingPoint, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field" style="margin:0;">
                        @Html.LabelFor(m => m.EndingPoint)
                        @Html.EditorFor(m => m.EndingPoint)
                        @Html.ValidationMessageFor(m => m.EndingPoint, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field" style="grid-column:1/-1;margin:0;">
                        @Html.LabelFor(m => m.PhotoProfileUrl)
                        @Html.EditorFor(m => m.PhotoProfileUrl)
                        @Html.ValidationMessageFor(m => m.PhotoProfileUrl, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field" style="grid-column:1/-1;margin:0;">
                        @Html.LabelFor(m => m.YouTubeLink)
                        @Html.EditorFor(m => m.YouTubeLink)
                        @Html.ValidationMessageFor(m => m.YouTubeLink, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field" style="grid-column:1/-1;margin:0;">
                        @Html.LabelFor(m => m.CulturalHighlights)
                        @Html.EditorFor(m => m.CulturalHighlights)
                        @Html.ValidationMessageFor(m => m.CulturalHighlights, "", new { @class = "field-validation-error" })
                    </div>
                    <div class="dt-field" style="grid-column:1/-1;margin:0;">
                        @Html.LabelFor(m => m.RouteStopsText)
                        @Html.TextAreaFor(m => m.RouteStopsText, new { rows = "4" })
                        @Html.ValidationMessageFor(m => m.RouteStopsText, "", new { @class = "field-validation-error" })
                    </div>
                </div>

                <button type="submit" class="dt-auth-submit" style="margin-top:24px;">
                    Save changes
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validate/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validate-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}

